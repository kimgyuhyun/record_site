// ============================================================================
// Grafana Alloy — 컨테이너 로그 수집 (docker.sock 없이)
// ----------------------------------------------------------------------------
// 왜 promtail 을 걷어냈나:
//   promtail 은 docker_sd_configs 로 컨테이너를 찾느라 /var/run/docker.sock 을
//   마운트해야 했다. 소켓이 붙은 컨테이너는 뚫리면 곧 호스트 장악이다 — Docker API
//   전체를 호출할 수 있어 호스트 / 를 마운트한 특권 컨테이너를 띄울 수 있기 때문이다.
//   `:ro` 는 이걸 막지 못한다: 읽기 전용 마운트는 파일시스템 쓰기를 막을 뿐이고
//   유닉스 소켓 connect() 는 그대로 된다. 즉 종전 설정의 ":ro 로 최소화한다"는
//   주석은 실제보다 안전하다고 말하고 있었다.
//
//   대신 /var/lib/docker/containers 를 읽기 전용으로 붙여 도커가 남긴 json-file
//   로그를 직접 tail 한다. 감수하는 위험은 "전 컨테이너 로그 열람"까지이고,
//   컨테이너 조작이나 호스트 접근은 불가하다.
//
// 컨테이너 이름을 어떻게 붙이나:
//   로그 파일 경로에는 컨테이너 ID밖에 없고, 소켓 없이는 ID→이름을 얻을 수 없다.
//   그래서 반대로 도커에게 이름을 로그에 써넣게 시킨다 —
//   docker-compose.monitoring.yml 에서 수집 대상마다
//     labels:  { log_service: backend }
//     logging: { driver: json-file, options: { labels: log_service } }
//   를 주면 json-file 드라이버가 각 줄에 {"attrs":{"log_service":"backend"}} 를
//   붙인다. 아래 파이프라인이 그 값을 service 라벨로 승격시킨다.
//   → log_service 라벨이 없는 컨테이너(관측 스택 자신)는 수집되지 않는다.
//     "라벨 없으면 수집 안 함"이 곧 제외 규칙이다.
// ============================================================================

logging {
	level  = "warn"
	format = "logfmt"
}

// 컨테이너가 생기고 사라지므로 파일 목록을 주기적으로 다시 훑는다.
local.file_match "containers" {
	path_targets = [{
		__path__ = "/var/lib/docker/containers/*/*-json.log",
	}]
	sync_period = "30s"
}

loki.source.file "containers" {
	targets    = local.file_match.containers.targets
	forward_to = [loki.process.docker.receiver]
}

loki.process "docker" {
	// json-file 한 줄의 껍데기:
	//   {"log":"...","stream":"stdout","attrs":{"log_service":"backend"},"time":"..."}
	stage.json {
		expressions = {
			log       = "log",
			stream    = "stream",
			timestamp = "time",
			service   = "attrs.log_service",
		}
	}

	stage.labels {
		values = {
			service = "",
			stream  = "",
		}
	}

	// 라벨 없는 컨테이너는 버린다(관측 스택 자기 로그가 되먹임되는 것도 여기서 막힌다).
	stage.match {
		selector            = "{service=\"\"}"
		action              = "drop"
		drop_counter_reason = "unlabeled_container"
	}

	// 수집 시각이 아니라 도커가 기록한 실제 시각을 쓴다.
	stage.timestamp {
		source = "timestamp"
		format = "RFC3339Nano"
	}

	// 여기서부터 본문은 json 껍데기가 아니라 원래 로그 한 줄이 된다.
	stage.output {
		source = "log"
	}

	// backend 만 구조화(logstash JSON) 로 찍는다 — 종전 promtail 설정과 같은 라벨을 만든다.
	// level 만 라벨로 올리고 나머지는 본문에 남긴다(카디널리티 억제).
	// nginx·mysql·redis 는 평문이라 이 블록에 들어오지 않는다.
	stage.match {
		selector = "{service=\"backend\"}"

		stage.json {
			expressions = {
				level = "level",
			}
		}

		stage.labels {
			values = {
				level = "",
			}
		}
	}

	// filename 에는 컨테이너 ID가 들어 있어 재생성 때마다 새 스트림이 된다 → 라벨에서 뺀다.
	stage.label_drop {
		values = ["filename"]
	}

	forward_to = [loki.write.default.receiver]
}

loki.write "default" {
	// loki 는 monitoring 망(grafana 조회 + 호스트 publish용)과 logpipe 망 양쪽에 있다.
	// alloy 는 logpipe(internal) 에만 붙으므로 인터넷 아웃바운드가 전혀 없다.
	endpoint {
		url = "http://loki:3100/loki/api/v1/push"
	}
}
